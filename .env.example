# Optional local overrides.
# The Docker stack runs without this file using demo-safe defaults.
# To use it: cp .env.example .env

# JWT signing secret (must be at least 32 characters).
# Replace this for any real deployment.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Email mode:
#   true  -> log emails to the console (no SMTP needed, default)
#   false -> send real email through Gmail SMTP
NOTIFICATION_EMAIL_MOCK=true
GMAIL_SMTP_USER=
GMAIL_SMTP_PASS=

# Optional host port overrides (defaults shown)
# FRONTEND_PORT=3100
# GATEWAY_PORT=8180
# REDIS_PORT=6380
# KAFKA_PORT=19092
